{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "pnpm-lock.yaml",
    "uv.lock",
    ".git",
    ".env*"
  ],
  "words": [
    "alembic",
    "configparser",
    "datefmt",
    "fastapi",
    "httpx",
    "levelname",
    "localtime",
    "notset",
    "pathsep",
    "poolclass",
    "psycopg",
    "pydantic",
    "pyproject",
    "pytest",
    "pythonpath",
    "qualname",
    "repr",
    "sqlalchemy",
    "sqlmodel",
    "sqltypes",
    "testpaths",
    "tzdata",
    "venv"
  ]
}
